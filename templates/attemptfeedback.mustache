{{!
    @template local_catquiz
    Template which defines a quiz attempt feedback.
    Classes required for JS:
    * none
    Data attributes required for JS:
    * none
    Context variables required for this template:
    Example context (json):
    {
        "feedback": {
            "enrolementmessage" : "String, <ul>...</ul>",
            "studentfeedback": [
                {
                    "generatorname": "studentfeedback_generator_name",
                    "heading": "Student Feedback 1",
                    "comment": "This is a comment.",
                    "content": "This is the content of student feedback 1.",
                    "frontpage": "1",
                    "othertabs": "1"
                }
            ],
            "teacherfeedback": [
                {
                    "generatorname": "teacherfeedback_generator_name",
                    "heading": "Teacher Feedback 1",
                    "comment": "This is a comment.",
                    "content": "This is the content of teacher feedback 1."
                }
            ]
        },
        "attemptid" : "111"
    }
}}


<div class="catquiz_feedback">
{{#nofeedback}}
    {{#str}} minquestionsnotreached, local_catquiz{{/str}}
{{/nofeedback}}
{{#feedback}}
<div class="catquiz_feedback">
  {{#studentfeedback}}
      {{#frontpage}}
          <h5 id="local-catquiz-feedback-{{uniqid}}-{{attemptid}}-{{generatorname}}-frontpage-heading"> {{{heading}}} </h5>
          <i id="local-catquiz-feedback-{{uniqid}}-{{attemptid}}-{{generatorname}}-frontpage-comment"> {{{comment}}} </i>
          <div id="local-catquiz-feedback-{{uniqid}}-{{attemptid}}-{{generatorname}}-frontpage-content"> {{{content}}} </div>
      {{/frontpage}}
  {{/studentfeedback}}
      {{! Ids carry the render and the attempt (issue #30): several feedbacks on one page - attempts in
          a list, a shortcode next to the result page - must not share tabs or panes. }}
      <ul class="nav nav-tabs" id="local-catquiz-feedback-{{uniqid}}-{{attemptid}}-tabs" role="tablist" style="list-style: none">
  {{#studentfeedback}}
      {{#othertabs}}
      <li class="nav-item">
          <a class="nav-link feedbacktab"
              id="local-catquiz-feedback-{{uniqid}}-{{attemptid}}-{{generatorname}}-student-tab"
              data-bs-toggle="tab"
              data-attemptid="{{attemptid}}"
              data-feedbackname="{{generatorname}}"
              data-feedbackname-translated="{{heading}}"
              href="#local-catquiz-feedback-{{uniqid}}-{{attemptid}}-{{generatorname}}-student"
              role="tab"
              aria-controls="local-catquiz-feedback-{{uniqid}}-{{attemptid}}-{{generatorname}}-student"
              aria-selected="true">{{heading}}
          </a>
      </li>
      {{/othertabs}}
  {{/studentfeedback}}
  {{#teacherfeedback}}
          <li class="nav-item">
              <a class="nav-link feedbacktab"
                  id="local-catquiz-feedback-{{uniqid}}-{{attemptid}}-{{generatorname}}-teacher-tab"
                  data-bs-toggle="tab"
                  data-attemptid="{{attemptid}}"
                  data-feedbackname="{{generatorname}}"
                  data-feedbackname-translated="{{heading}}"
                  href="#local-catquiz-feedback-{{uniqid}}-{{attemptid}}-{{generatorname}}-teacher"
                  role="tab"
                  aria-controls="local-catquiz-feedback-{{uniqid}}-{{attemptid}}-{{generatorname}}-teacher"
                  aria-selected="false">{{heading}}
              </a>
          </li>
  {{/teacherfeedback}}
  {{#studentfeedback.0}}
      </ul>
      <div class="tab-content" id="local-catquiz-feedback-{{uniqid}}-{{attemptid}}-panes" style="margin:20px">
  {{/studentfeedback.0}}

  {{#studentfeedback}}
      {{#othertabs}}
          <div class="tab-pane fade" id="local-catquiz-feedback-{{uniqid}}-{{attemptid}}-{{generatorname}}-student" role="tabpanel" aria-labelledby="local-catquiz-feedback-{{uniqid}}-{{attemptid}}-{{generatorname}}-student-tab">
              <div class="feedbackcontent-{{generatorname}}">
                  <h5> {{{heading}}} </h5>
                  <i> {{{comment}}} </i>
                  <div> {{{content}}} </div>
              </div>
          </div>
      {{/othertabs}}
  {{/studentfeedback}}
  {{#teacherfeedback}}
          <div class="tab-pane fade" id="local-catquiz-feedback-{{uniqid}}-{{attemptid}}-{{generatorname}}-teacher" role="tabpanel" aria-labelledby="local-catquiz-feedback-{{uniqid}}-{{attemptid}}-{{generatorname}}-teacher-tab">
              <div class="feedbackcontent-{{generatorname}}">
                  <h5> {{{heading}}} </h5>
                  <i> {{{comment}}} </i>
                  <div> {{{content}}} </div>
              </div>
          </div>
  {{/teacherfeedback}}
  {{#studentfeedback.0}}
      </div>
  {{/studentfeedback.0}}
</div>
{{/feedback}}
</div>

{{#enrolementmessage}}
<div class="container mt-5">
  <div class="alert alert-info" role="alert" style="line-height:2">
    <h4 class="alert-heading">{{#str}} enrolmentmessagetitle, local_catquiz {{/str}}</h4>
    {{{enrolementmessage}}}
  </div>
</div>
{{/enrolementmessage}}

{{#js}}
    require(['local_catquiz/feedback'], function(init) {
      init.init();
  });
{{/js}}
